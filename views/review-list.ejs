<%- include('partials/header') %>
<p><a href="/review">← Program committee</a></p>
<div class="row-between">
  <h1><%= conf.name %></h1>
  <% if (user.role === 'admin') { %>
  <div class="actions">
    <a class="btn btn-ghost" href="/admin/export/submissions.xlsx?conference=<%= conf.slug %>">⬇ Submissions (.xlsx)</a>
    <a class="btn btn-ghost" href="/admin/export/workbook.xlsx?conference=<%= conf.slug %>">⬇ Full workbook</a>
  </div>
  <% } %>
</div>
<p class="muted">
  <% ['submitted','accepted','waitlisted','rejected','withdrawn'].forEach(s => { %>
    <span class="<%= badgeClass(s) %>"><%= statusLabel(s) %>: <%= counts[s] || 0 %></span>
  <% }) %>
  <% if (blind) { %> · <strong>Anonymous review</strong><% } %>
  <% if (user.role === 'admin') { %> · Decisions <strong><%= conf.decisions_published ? 'published to speakers' : 'not yet visible to speakers' %></strong> (<a href="/admin/conferences/<%= conf.id %>#publish">change</a>)<% } %>
</p>

<form method="get" class="filters card">
  <label>Status <select name="status"><option value="">All active</option>
    <% STATUSES.forEach(s => { %><option value="<%= s %>" <%= filter.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select></label>
  <% if (conf.topicList.length) { %>
  <label>Topic <select name="topic"><option value="">All</option>
    <% conf.topicList.forEach(t => { %><option <%= filter.topic === t ? 'selected' : '' %>><%= t %></option><% }) %></select></label>
  <% } %>
  <label>Sort <select name="sort">
    <% [['newest','Newest'],['score','Average score'],['reviews','Fewest reviews'],['title','Title']].forEach(([v, l]) => { %><option value="<%= v %>" <%= filter.sort === v ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
  <label class="check"><input type="checkbox" name="todo" value="1" <%= filter.todo ? 'checked' : '' %>> Only ones I haven't reviewed</label>
  <button class="btn btn-small">Apply</button>
</form>

<% if (!proposals.length) { %>
  <div class="card empty"><%= filter.todo ? "🎉 You've reviewed everything here." : 'No proposals match.' %></div>
<% } else { %>
<form method="post" action="/review/conferences/<%= conf.id %>/bulk-decision">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="return_to" value="<%= returnTo %>">
<div class="table-wrap card flush">
<table>
  <thead><tr>
    <% if (user.role === 'admin') { %><th><input type="checkbox" onclick="document.querySelectorAll('input[name=ids]').forEach(c => c.checked = this.checked)" aria-label="Select all"></th><% } %>
    <th>Title</th><% if (!blind) { %><th>Speaker</th><% } %><th>Format / topic</th><th>Reviews</th><th>Avg</th><th>Mine</th><th>Status</th>
  </tr></thead>
  <tbody>
  <% proposals.forEach(p => { %>
    <tr>
      <% if (user.role === 'admin') { %><td><input type="checkbox" name="ids" value="<%= p.id %>" aria-label="Select"></td><% } %>
      <td><a href="/review/proposals/<%= p.id %>"><strong><%= p.title %></strong></a></td>
      <% if (!blind) { %><td><%= p.speaker_name %><% if (p.speaker_organization) { %><br><span class="small muted"><%= p.speaker_organization %></span><% } %></td><% } %>
      <td><%= p.format %><% if (p.topic) { %><br><span class="small muted"><%= p.topic %></span><% } %></td>
      <td class="num"><%= p.review_count %></td>
      <td class="num"><strong><%= p.avg_score ?? '–' %></strong></td>
      <td class="num"><%= p.speaker_id === user.id ? 'own' : (p.my_score ? `${p.my_score} · ${p.my_recommendation}` : '–') %></td>
      <td><span class="<%= badgeClass(p.status) %>"><%= statusLabel(p.status) %></span>
        <% if (p.status === 'accepted' && p.speaker_confirmation) { %><br><span class="small muted"><%= p.speaker_confirmation %></span><% } %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (user.role === 'admin') { %>
<div class="bulk card">
  <label>Set selected to
    <select name="status" required><option value="">Choose…</option><% DECISIONS.forEach(s => { %><option value="<%= s %>"><%= statusLabel(s) %></option><% }) %></select></label>
  <button class="btn btn-small">Apply decision</button>
</div>
<% } %>
</form>
<% } %>
<%- include('partials/footer') %>
