<%- include('partials/header') %>
<div class="row-between">
  <h1>Organiser dashboard</h1>
  <div class="actions">
    <a class="btn btn-ghost" href="/admin/users">People</a>
    <a class="btn btn-ghost" href="/admin/exports">Spreadsheet exports</a>
    <a class="btn" href="/admin/conferences/new">New conference</a>
  </div>
</div>
<% if (conferences.length) {
  const sum = (k) => conferences.reduce((n, c) => n + (c.stats[k] || 0), 0); %>
<div class="stats">
  <% [['total', 'Proposals'], ['pending', 'Pending decision'], ['accepted', 'Accepted'], ['confirmed', 'Speakers confirmed']].forEach(([k, label]) => { %>
  <div class="stat-card"><span class="stat-num"><%= sum(k) %></span><span class="stat-label"><%= label %></span></div>
  <% }) %>
</div>
<% } %>
<% if (!conferences.length) { %>
  <div class="card empty"><p>No conferences yet.</p><a class="btn" href="/admin/conferences/new">Create your first conference</a></div>
<% } else { %>
<div class="table-wrap card flush">
<table>
  <thead><tr><th>Conference</th><th>CFP</th><th class="num">Proposals</th><th class="num">Pending</th><th class="num">Accepted</th><th class="num">Confirmed</th><th class="num">Committee</th><th>Decisions</th><th></th></tr></thead>
  <tbody>
  <% conferences.forEach(c => { %>
    <tr class="<%= c.archived ? 'dim' : '' %>">
      <td><strong><a href="/review/conferences/<%= c.id %>"><%= c.name %></a></strong><br><span class="small muted"><%= dateRange(c.start_date, c.end_date) %></span></td>
      <td><span class="<%= badgeClass('cfp-' + c.cfpState) %>"><%= CFP_LABELS[c.cfpState] %></span><% if (c.cfp_closes) { %><br><span class="small muted">closes <%= formatDate(c.cfp_closes) %></span><% } %></td>
      <td class="num"><%= c.stats.total %></td>
      <td class="num"><%= c.stats.pending || 0 %></td>
      <td class="num"><%= c.stats.accepted || 0 %></td>
      <td class="num"><%= c.stats.confirmed || 0 %></td>
      <td class="num"><%= c.reviewers %></td>
      <td><%= c.decisions_published ? 'Published' : 'Hidden' %></td>
      <td class="nowrap"><a href="/review/conferences/<%= c.id %>">Proposals</a> · <a href="/admin/conferences/<%= c.id %>">Settings</a> · <a href="/admin/export/workbook.xlsx?conference=<%= c.slug %>">⬇ xlsx</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('partials/footer') %>
