<%- include('partials/header') %>
<p><a href="/proposals">← My proposals</a></p>
<div class="row-between">
  <div>
    <span class="<%= badgeClass(shownStatus) %>"><%= statusLabel(shownStatus) %></span>
    <h1><%= p.title %></h1>
    <p class="muted"><%= p.conference_name %> · <%= [p.format, p.track, p.level].filter(Boolean).join(' · ') %> · version <%= p.version %></p>
  </div>
  <div class="actions">
    <% if (editable) { %><a class="btn" href="/proposals/<%= p.id %>/edit">Edit proposal</a><% } %>
  </div>
</div>

<% if (shownStatus === 'accepted') { %>
<section class="card callout callout-success">
  <h2>🎉 Your proposal was accepted</h2>
  <% if (p.feedback_to_speaker) { %><div class="prose"><%= p.feedback_to_speaker %></div><% } %>
  <% if (!p.speaker_confirmation) { %>
    <p>Please confirm that you will present this session.</p>
    <div class="actions">
      <form method="post" action="/proposals/<%= p.id %>/confirm" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="answer" value="confirm"><button class="btn">Confirm I'll speak</button></form>
      <form method="post" action="/proposals/<%= p.id %>/confirm" class="inline" onsubmit="return confirm('Decline this speaking slot? This cannot be undone from here.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="answer" value="decline"><button class="btn btn-danger">I can no longer speak</button></form>
    </div>
  <% } else if (p.speaker_confirmation === 'confirmed') { %>
    <p><strong>You confirmed on <%= formatDate(p.confirmed_at) %>.</strong> You can still update your title and abstract for the program.</p>
    <form method="post" action="/proposals/<%= p.id %>/confirm" class="inline" onsubmit="return confirm('Withdraw from speaking?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="answer" value="decline"><button class="linklike danger">I can no longer speak</button></form>
  <% } else { %>
    <p>You declined this slot on <%= formatDate(p.confirmed_at) %>.</p>
  <% } %>
</section>
<% } else if (['waitlisted','rejected'].includes(shownStatus) && p.feedback_to_speaker) { %>
<section class="card callout"><h2>Feedback from the committee</h2><div class="prose"><%= p.feedback_to_speaker %></div></section>
<% } %>

<div class="two-col wide-left">
<section class="card">
  <h2>Abstract</h2>
  <div class="prose"><%= p.abstract %></div>
  <% if (p.description) { %><h2>Details for the committee</h2><div class="prose"><%= p.description %></div><% } %>
  <% if (p.co_speakers) { %><h2>Co-speakers</h2><div class="prose"><%= p.co_speakers %></div><% } %>
  <% if (p.notes) { %><h2>Notes for the organisers</h2><div class="prose"><%= p.notes %></div><% } %>
</section>
<aside class="card">
  <dl class="facts">
    <dt>Submitted</dt><dd><%= formatDate(p.submitted_at) %></dd>
    <dt>Last updated</dt><dd><%= formatDate(p.updated_at) %></dd>
    <% if (p.duration_minutes) { %><dt>Preferred length</dt><dd><%= p.duration_minutes %> min</dd><% } %>
    <% if (conf.cfp_closes) { %><dt>CFP closes</dt><dd><%= formatDate(conf.cfp_closes) %></dd><% } %>
  </dl>
  <% if (history.length) { %>
  <h3>Activity</h3>
  <ul class="timeline">
    <% history.forEach(h => { %><li><span class="small muted"><%= formatDate(h.created_at) %></span> <%= h.action %><% if (h.detail && h.action === 'edited') { %> <span class="small muted">(<%= h.detail.replace('Changed: ', '') %>)</span><% } %></li><% }) %>
  </ul>
  <% } %>
  <% if (shownStatus !== 'withdrawn' && shownStatus !== 'rejected' && p.speaker_confirmation !== 'declined') { %>
  <form method="post" action="/proposals/<%= p.id %>/withdraw" onsubmit="return confirm('Withdraw this proposal? You will not be able to undo this.')">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="linklike danger">Withdraw proposal</button>
  </form>
  <% } %>
</aside>
</div>
<%- include('partials/footer') %>
