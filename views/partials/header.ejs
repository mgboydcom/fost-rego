<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#020616">
  <title><%= title ? `${title} · ` : '' %>FOST Call for Speakers</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/" aria-label="FOST Call for Speakers, home"><span class="brand-mark">FOST</span><span class="brand-sub">Call for speakers</span></a>
    <nav>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Open calls</a>
      <% if (user) { %>
        <a href="/proposals" class="<%= path.startsWith('/proposals') ? 'active' : '' %>">My proposals</a>
        <% if (user.role === 'reviewer' || user.role === 'admin') { %>
          <a href="/review" class="<%= path.startsWith('/review') ? 'active' : '' %>">Review</a>
        <% } %>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Organise</a>
        <% } %>
        <a href="/profile" class="<%= path === '/profile' ? 'active' : '' %>"><%= user.first_name %></a>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="nav-button">Sign out</button></form>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/register" class="btn btn-small">Create account</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
