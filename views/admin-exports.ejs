<%- include('partials/header') %>
<p><a href="/admin">← Organiser dashboard</a></p>
<h1>Spreadsheet exports</h1>
<p>Every dataset is a flat table with stable column names, ready for mail merges, Google Sheets, Excel, Airtable, Zapier, Make or any other workflow tool.</p>

<section class="card">
  <h2>Download now</h2>
  <form method="get" action="/admin/export/workbook.xlsx" class="filters" id="dl">
    <label>Conference <select name="conference" id="dl-conf"><option value="">All conferences</option>
      <% conferences.forEach(c => { %><option value="<%= c.slug %>"><%= c.name %></option><% }) %></select></label>
  </form>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Dataset</th><th>What's in it</th><th>Download</th></tr></thead>
    <tbody>
    <% [
      ['workbook', 'All of the below, one tab each', ['xlsx']],
      ['submissions', 'One row per proposal: talk details, speaker contact details, status, review scores, confirmation, feedback, timestamps, links', ['xlsx','csv']],
      ['program', 'Accepted talks only, with speaker bio/photo and confirmation status: for the website, schedule and speaker comms', ['xlsx','csv']],
      ['speakers', 'One row per speaker with proposal counts by outcome: for mailing lists and speaker management', ['xlsx','csv']],
      ['reviews', 'One row per review: reviewer, score, recommendation, comments', ['xlsx','csv']],
      ['conferences', 'Conference settings and headline numbers', ['xlsx','csv']],
    ].forEach(([name, desc, exts]) => { %>
      <tr><td><strong><%= name %></strong></td><td><%= desc %></td>
        <td class="nowrap"><% exts.forEach(ext => { %><a class="btn btn-small btn-ghost dl-link" data-href="/admin/export/<%= name %>.<%= ext %>" href="/admin/export/<%= name %>.<%= ext %>">.<%= ext %></a> <% }) %></td></tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</section>

<section class="card">
  <h2>Live links for automation</h2>
  <p>These URLs always return the current data without signing in, so workflow tools can poll them. <strong>Treat them like a password</strong>: they include speaker contact details.</p>
  <div class="table-wrap">
  <table class="code-table">
    <tbody>
    <% ['submissions','program','speakers','reviews','conferences'].forEach(name => { %>
      <tr><td><strong><%= name %></strong></td><td><code><%= base %>/api/export/<%= token %>/<%= name %>.csv</code></td></tr>
    <% }) %>
      <tr><td><strong>workbook</strong></td><td><code><%= base %>/api/export/<%= token %>/workbook.xlsx</code></td></tr>
    </tbody>
  </table>
  </div>
  <h3>Options</h3>
  <ul>
    <li>Swap <code>.csv</code> for <code>.xlsx</code> or <code>.json</code>.</li>
    <li><code>?conference=&lt;slug&gt;</code> limits to one conference<% if (conferences[0]) { %>, e.g. <code>?conference=<%= conferences[0].slug %></code><% } %>.</li>
    <li><code>?status=accepted</code> (or submitted, waitlisted, rejected, withdrawn) filters by status.</li>
    <li><code>?updated_since=2026-01-31T00:00:00Z</code> returns only rows changed since a time, for incremental syncs ("new or updated proposals since the last run").</li>
  </ul>
  <h3>Examples</h3>
  <ul>
    <li><strong>Google Sheets</strong>: in a cell, <code>=IMPORTDATA("<%= base %>/api/export/<%= token %>/program.csv")</code>. The sheet refreshes about every hour.</li>
    <li><strong>Zapier / Make / Power Automate</strong>: schedule an HTTP GET of <code>submissions.json?updated_since=…</code> and branch on <code>status</code>, <code>decisions_published</code> and <code>speaker_confirmation</code> to send acceptance, reminder and logistics emails.</li>
    <li><strong>Mail merge</strong>: download <code>program.xlsx</code> and use <code>speaker_name</code>, <code>speaker_email</code>, <code>title</code> and <code>feedback_to_speaker</code> as merge fields.</li>
  </ul>
  <form method="post" action="/admin/exports/rotate-token" onsubmit="return confirm('Regenerate the token? Existing automation links will stop working.')">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="linklike danger">Regenerate secret token</button>
  </form>
</section>
<script>
  document.getElementById('dl-conf').addEventListener('change', function () {
    const q = this.value ? '?conference=' + encodeURIComponent(this.value) : '';
    document.querySelectorAll('.dl-link').forEach(a => { a.href = a.dataset.href + q; });
  });
</script>
<%- include('partials/footer') %>
