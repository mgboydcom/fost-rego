<%- include('partials/header') %>
<h1>Your speaker profile</h1>
<p class="muted">This information is shared with the program committee and, if your talk is accepted, used on the conference website and in speaker communications.</p>
<div class="two-col">
<section class="card">
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/profile" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field-row">
      <label>First name <input name="first_name" value="<%= values.first_name %>" required autocomplete="given-name"></label>
      <label>Last name <input name="last_name" value="<%= values.last_name %>" autocomplete="family-name"></label>
    </div>
    <div class="field-row">
      <label>Job title <input name="job_title" value="<%= values.job_title %>"></label>
      <label>Organisation <input name="organization" value="<%= values.organization %>"></label>
    </div>
    <label>Short bio <span class="opt">third person, ~100 words</span>
      <textarea name="bio" rows="6"><%= values.bio %></textarea></label>
    <label>LinkedIn profile URL <input name="linkedin_profile_url" inputmode="url" autocomplete="url" value="<%= values.linkedin_profile_url %>" placeholder="https://www.linkedin.com/in/your-name"></label>
    <div class="field-row">
      <label>Phone <span class="opt">organisers only</span> <input name="phone" value="<%= values.phone %>"></label>
      <label>Country
        <select name="country" autocomplete="country">
          <option value="">Not specified</option>
          <% COUNTRIES.forEach(c => { %><option value="<%= c.code %>" <%= values.country === c.code ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select></label>
    </div>
    <label>Headshot URL <span class="opt">Optional. If you leave this blank, we'll use the photo on your LinkedIn profile.</span>
      <input name="photo_url" value="<%= values.photo_url %>" placeholder="https://…/photo.jpg"></label>
    <button class="btn">Save profile</button>
  </form>
</section>
<section class="card">
  <h2>Account</h2>
  <p><strong>Email:</strong> <%= user.email %><br><strong>Role:</strong> <%= user.role %></p>
  <h3>Change password</h3>
  <form method="post" action="/profile/password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Current password <input type="password" name="current_password" required autocomplete="current-password"></label>
    <label>New password <input type="password" name="new_password" minlength="8" required autocomplete="new-password"></label>
    <button class="btn btn-ghost">Change password</button>
  </form>
</section>
</div>
<%- include('partials/footer') %>
