<%- include('partials/header') %>
<section class="hero">
  <h1>Speak at our conferences</h1>
  <p>Share what you know. Pick a conference, submit a proposal, and keep it up to date until the call closes. Our program committee reviews every submission.</p>
  <% if (!user) { %><p><a class="btn" href="/register">Create an account to submit</a> <a class="btn btn-ghost" href="/login">Sign in</a></p><% } %>
</section>
<% if (!conferences.length) { %>
  <div class="card empty">No calls for proposals are listed yet. <% if (user && user.role === 'admin') { %><a href="/admin/conferences/new">Create the first conference</a>.<% } %></div>
<% } %>
<div class="grid">
<% conferences.forEach(c => { %>
  <article class="card conf-card">
    <div class="row-between">
      <span class="<%= badgeClass('cfp-' + c.cfpState) %>"><%= CFP_LABELS[c.cfpState] %></span>
      <% if (c.cfp_closes) { %><span class="muted small">Closes <%= formatDate(c.cfp_closes) %></span><% } %>
    </div>
    <h2><a href="/cfp/<%= c.slug %>"><%= c.name %></a></h2>
    <p class="muted"><%= [dateRange(c.start_date, c.end_date), c.location].filter(Boolean).join(' · ') %></p>
    <p class="clamp"><%= c.description %></p>
    <div class="actions">
      <a class="btn btn-ghost" href="/cfp/<%= c.slug %>">Details</a>
      <% if (c.cfpOpen) { %><a class="btn" href="/proposals/new?conference=<%= c.slug %>">Submit a proposal</a><% } %>
    </div>
  </article>
<% }) %>
</div>
<%- include('partials/footer') %>
