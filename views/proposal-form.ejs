<%- include('partials/header') %>
<h1><%= proposal ? 'Edit proposal' : 'Submit a proposal' %></h1>
<% if (proposal) { const conf = confs[0]; %>
<p class="muted">Conference: <strong><%= conf.name %></strong>
  <% if (edit) { %> · <span class="edit-window edit-<%= edit.tone %>"><%= edit.label %></span><% if (edit.deadline) { %> (until <%= formatDate(edit.deadline) %>)<% } %><% } %></p>
<% } else { %>
<p class="muted">Write your proposal once and send it to one or more conferences. Each conference reviews its copy separately, and you can edit each copy on its own later.</p>
<% } %>
<% if (confs.some(c => c.blind_review && (proposal || selected.includes(c.id)))) { %><div class="flash flash-info">At least one conference you chose uses anonymous review. Please leave your name and employer out of the title and abstract.</div><% } %>
<% if (errors.length) { %><div class="flash flash-error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
<section class="card">
<form method="post" action="<%= proposal ? `/proposals/${proposal.id}/edit` : '/proposals' %>" class="form" id="proposal-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <fieldset class="conf-picks">
    <legend><%= proposal ? 'Conference' : 'Conferences' %></legend>
    <% if (!proposal) { %><p class="small muted">Tick every conference you want to speak at, then choose a session format and topic for each.</p><% } %>
    <% confs.forEach(c => { const on = !!proposal || selected.includes(c.id); const pick = picks[c.id] || {}; %>
    <div class="conf-pick<%= on ? ' on' : '' %>" data-conf-pick>
      <% if (proposal) { %>
        <input type="hidden" name="conference_ids" value="<%= c.id %>">
        <div class="conf-pick-head"><strong><%= c.name %></strong></div>
      <% } else { %>
        <label class="check conf-pick-head">
          <input type="checkbox" name="conference_ids" value="<%= c.id %>" <%= on ? 'checked' : '' %> data-conf-toggle>
          <span><strong><%= c.name %></strong><br><span class="small muted"><%= [dateRange(c.start_date, c.end_date), c.location, c.cfp_closes ? `call closes ${formatDate(c.cfp_closes)}` : ''].filter(Boolean).join(' · ') %></span></span>
        </label>
      <% } %>
      <div class="field-row conf-fields" data-conf-fields>
        <label>Session format
          <select name="format_<%= c.id %>" data-required>
            <option value="">Choose…</option>
            <% c.formatList.forEach(f => { %><option <%= pick.format === f ? 'selected' : '' %>><%= f %></option><% }) %>
            <% if (pick.format && !c.formatList.includes(pick.format)) { %><option selected><%= pick.format %></option><% } %>
          </select></label>
        <% if (c.topicList.length || pick.topic) { %>
        <label>Topic
          <select name="topic_<%= c.id %>" data-required>
            <option value="">Choose…</option>
            <% c.topicList.forEach(t => { %><option <%= pick.topic === t ? 'selected' : '' %>><%= t %></option><% }) %>
            <% if (pick.topic && !c.topicList.includes(pick.topic)) { %><option selected><%= pick.topic %></option><% } %>
          </select></label>
        <% } %>
      </div>
    </div>
    <% }) %>
  </fieldset>

  <label>Title <input name="title" value="<%= values.title || '' %>" maxlength="200" required></label>
  <label>Abstract <span class="opt">public description shown in the program, up to 3000 characters</span>
    <textarea name="abstract" rows="7" maxlength="3000" required><%= values.abstract || '' %></textarea></label>
  <label>Audience level
    <select name="level">
      <option value="">Not specified</option>
      <% LEVELS.forEach(l => { %><option <%= values.level === l ? 'selected' : '' %>><%= l %></option><% }) %>
    </select></label>
  <label>Co-speakers <span class="opt">name and email, one per line</span>
    <textarea name="co_speakers" rows="2"><%= values.co_speakers || '' %></textarea></label>
  <label>Notes for the organisers <span class="opt">availability, accessibility needs, anything else</span>
    <textarea name="notes" rows="3"><%= values.notes || '' %></textarea></label>
  <div class="actions">
    <button class="btn" data-submit><%= proposal ? 'Save changes' : 'Submit proposal' %></button>
    <a class="btn btn-ghost" href="<%= proposal ? `/proposals/${proposal.id}` : '/proposals' %>">Cancel</a>
  </div>
</form>
</section>
<script>
  // Show format and topic only for ticked conferences, and require them only there.
  (function () {
    const form = document.getElementById('proposal-form');
    const button = form.querySelector('[data-submit]');
    const isEdit = <%= proposal ? 'true' : 'false' %>;
    function sync() {
      let count = 0;
      form.querySelectorAll('[data-conf-pick]').forEach(function (block) {
        const box = block.querySelector('[data-conf-toggle]');
        const on = box ? box.checked : true;
        if (on) count += 1;
        block.classList.toggle('on', on);
        block.querySelector('[data-conf-fields]').hidden = !on;
        block.querySelectorAll('[data-required]').forEach(function (s) { s.required = on; });
      });
      if (!isEdit) button.textContent = count > 1 ? 'Submit to ' + count + ' conferences' : 'Submit proposal';
    }
    form.addEventListener('change', function (e) { if (e.target.matches('[data-conf-toggle]')) sync(); });
    form.addEventListener('submit', function (e) {
      if (!isEdit && !form.querySelector('[data-conf-toggle]:checked')) {
        e.preventDefault();
        alert('Choose at least one conference to submit to.');
      }
    });
    sync();
  })();
</script>
<%- include('partials/footer') %>
