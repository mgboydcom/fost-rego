{
  "name": "fost-rego",
  "version": "2.0.0",
  "private": true,
  "description": "FOST Call for Speakers: speakers submit and edit proposals, a program committee reviews and decides, and everything exports to spreadsheets. Next.js + PostgreSQL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.mts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^15.5.27",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
